# Neon connection string (use the pooled one on Vercel)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Auth.js: generate with `npx auth secret`
AUTH_SECRET=
# Code for the admin "first-time setup or forgot password" form on the login page.
# Anyone with this code and an admin email can set that email's password, so keep it long and private.
SETUP_CODE=

# Optional: Google sign-in (console.cloud.google.com > Google Auth Platform > Clients)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Main admin. ADMIN_PASSWORD is applied on the next deploy (hashed; the value is never stored or logged)
# and again only when you change it. Mark it Sensitive in Vercel.
ADMIN_EMAIL=rk.vasamsetty@gmail.com
ADMIN_PASSWORD=
# Other admin emails (comma separated). Admins add other family members in the app under Family users.
ALLOWED_EMAILS=you@gmail.com

# Any long random passphrase (or a 32-byte base64 key: openssl rand -base64 32)
ENCRYPTION_KEY=

# Optional: reads PDF statements and suggests heads for new transactions
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: daily reminder email via Resend (resend.com)
RESEND_API_KEY=
REMINDER_FROM=Family Finance Manager <onboarding@resend.dev>
REMINDER_TO=you@gmail.com
# Vercel sets this header on cron calls when CRON_SECRET is defined
CRON_SECRET=
