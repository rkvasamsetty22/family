# Neon connection string (use the pooled one on Vercel)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Auth.js: generate with `npx auth secret`
AUTH_SECRET=
# Google OAuth client (console.cloud.google.com > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated emails allowed to sign in
ALLOWED_EMAILS=you@gmail.com,spouse@gmail.com

# Any long random passphrase (or a 32-byte base64 key: openssl rand -base64 32)
ENCRYPTION_KEY=

# Optional: reads PDF statements and suggests heads for new transactions
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: daily reminder email via Resend (resend.com)
RESEND_API_KEY=
REMINDER_FROM=Family Finance <onboarding@resend.dev>
REMINDER_TO=you@gmail.com
# Vercel sets this header on cron calls when CRON_SECRET is defined
CRON_SECRET=
